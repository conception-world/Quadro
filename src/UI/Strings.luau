function Strings.get(lang: string, key: string, ...: any): string
	local localized = tables[lang]
	local text = (localized and localized[key]) or tables.en[key] or key
	if select("#", ...) > 0 then
		return string.format(text, ...)
	end
	return text
end

function Strings.missing(lang: string): { string }
	local target = tables[lang] or {}
	local out = {}
	for key in tables.en do
		if target[key] == nil then
			table.insert(out, key)
		end
	end
	table.sort(out)
	return out
end

return Strings
