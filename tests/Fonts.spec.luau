local Fonts = require("../src/Import/Fonts")

return function(t)
	t.case("maps Montserrat ExtraBold Italic", function()
		local f = Fonts.resolve("Montserrat", 800, true)
		t.eq(f.family, "rbxasset://fonts/families/Montserrat.json")
		t.eq(f.weight, "ExtraBold")
		t.eq(f.style, "Italic")
		t.eq(f.known, true)
	end)
	t.case("maps Gotham SSm Black to GothamSSm Heavy", function()
		local f = Fonts.resolve("Gotham SSm", 900, false)
		t.eq(f.family, "rbxasset://fonts/families/GothamSSm.json")
		t.eq(f.weight, "Heavy")
	end)
	t.case("unknown family falls back and is flagged", function()
		local f = Fonts.resolve("Papyrus", 400, false)
		t.eq(f.family, "rbxasset://fonts/families/GothamSSm.json")
		t.eq(f.known, false)
	end)
	t.case("weight rounds to the nearest hundred", function()
		t.eq(Fonts.resolve("Inter", 650, false).weight, "Bold")
	end)
	t.case("invalid weights clamp to a valid name", function()
		t.eq(Fonts.resolve("Inter", 0 / 0, false).weight, "Regular")
		t.eq(Fonts.resolve("Inter", 5000, false).weight, "Heavy")
		t.eq(Fonts.resolve("Inter", -10, false).weight, "Thin")
	end)
end
