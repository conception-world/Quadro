local Geometry = require("../src/Geometry")

return function(t)
	t.case("round4 rounds to four decimals", function()
		t.eq(Geometry.round4(0.123456), 0.1235)
	end)
	t.case("toScale divides by the reference", function()
		t.near(Geometry.toScale(415, 840), 0.494)
	end)
	t.case("toScale with zero reference is zero", function()
		t.eq(Geometry.toScale(10, 0), 0)
	end)
	t.case("axisToScale keeps the absolute size", function()
		local scale, offset = Geometry.axisToScale(0.5, 20, 200)
		t.near(scale, 0.6)
		t.eq(offset, 0)
	end)
	t.case("axisToOffset keeps the absolute size in whole pixels", function()
		local scale, offset = Geometry.axisToOffset(0.5, 20.4, 200)
		t.eq(scale, 0)
		t.eq(offset, 120)
	end)
	t.case("pixelSnap rounds to the nearest pixel", function()
		t.eq(Geometry.pixelSnap(12.6), 13)
		t.eq(Geometry.pixelSnap(12.4), 12)
	end)
	t.case("anchorShift moves the position so the box stays put", function()
		t.eq(Geometry.anchorShift(100, 50, 0, 0.5), 125)
		t.eq(Geometry.anchorShift(125, 50, 0.5, 0), 100)
	end)
	t.case("centerPosition matches the Figma card measured in Studio", function()
		t.near(Geometry.centerPosition(0, 415, 0.5, 840), 0.247)
	end)
	t.case("cornerScale uses the shortest side and caps at 0.5", function()
		t.near(Geometry.cornerScale(4, 415, 123), 0.0325)
		t.eq(Geometry.cornerScale(100, 40, 40), 0.5)
		t.eq(Geometry.cornerScale(4, 0, 10), 0)
	end)
	t.case("strokeScale uses the shortest side", function()
		t.near(Geometry.strokeScale(1.5, 415, 123), 0.0122)
		t.eq(Geometry.strokeScale(2, 10, 0), 0)
	end)
	t.case("innerSize subtracts padding and never goes negative", function()
		t.eq(Geometry.innerSize(840, 20, 20), 800)
		t.eq(Geometry.innerSize(10, 20, 20), 0)
	end)
	t.case("axisToScale with zero reference keeps the value", function()
		local scale, offset = Geometry.axisToScale(0.5, 100, 0)
		t.eq(scale, 0.5)
		t.eq(offset, 100)
	end)
	t.case("axisToOffset with zero reference keeps the value", function()
		local scale, offset = Geometry.axisToOffset(0.5, 100, 0)
		t.eq(scale, 0.5)
		t.eq(offset, 100)
	end)
	t.case("round4 rounds negatives symmetrically", function()
		t.eq(Geometry.round4(-0.12345), -0.1235)
	end)
	t.case("solveAxis keeps scale units", function()
		local scale, offset = Geometry.solveAxis(0.5, 0, 150, 300, 1, false)
		t.near(scale, 0.5)
		t.eq(offset, 0)
	end)
	t.case("solveAxis keeps offset units", function()
		local scale, offset = Geometry.solveAxis(0, 80, 120, 300, 1, false)
		t.eq(scale, 0)
		t.eq(offset, 120)
	end)
	t.case("solveAxis with preferScale converts offset to scale", function()
		local scale, offset = Geometry.solveAxis(0, 80, 150, 300, 1, true)
		t.near(scale, 0.5)
		t.eq(offset, 0)
	end)
	t.case("solveAxis divides by the UIScale unit", function()
		local scale, offset = Geometry.solveAxis(0, 0, 200, 300, 2, false)
		t.eq(scale, 0)
		t.eq(offset, 100)
	end)
	t.case("solveAxis with zero reference keeps the value", function()
		local scale, offset = Geometry.solveAxis(0.25, 4, 99, 0, 1, true)
		t.eq(scale, 0.25)
		t.eq(offset, 4)
	end)
	t.case("hybridSplit keeps pixels within one", function()
		for _, abs in { 0, 1, 37, 123, 400, 777, -50 } do
			for _, ref in { 100, 333, 1000, 1920 } do
				for _, portion in { 0, 0.3, 0.7, 1 } do
					local scale, offset = Geometry.hybridSplit(abs, ref, portion)
					t.near(scale * ref + offset, abs, 1)
				end
			end
		end
	end)
	t.case("hybridSplit portion 0.7 on 200 of 400", function()
		local scale, offset = Geometry.hybridSplit(200, 400, 0.7)
		t.near(scale, 0.35)
		t.eq(offset, 60)
	end)
	t.case("hybridSplit with zero reference is pure offset", function()
		local scale, offset = Geometry.hybridSplit(123.4, 0, 0.7)
		t.eq(scale, 0)
		t.eq(offset, 123)
	end)
	t.case("hybridSplit divides the offset by the UIScale unit", function()
		local scale, offset = Geometry.hybridSplit(200, 400, 0, 2)
		t.eq(scale, 0)
		t.eq(offset, 100)
	end)
	t.case("hybridSplit snaps the offset to whole pixels", function()
		local _, offset = Geometry.hybridSplit(100, 333, 0.7)
		t.eq(offset, math.floor(offset))
	end)
	t.case("cornerConvert round-trips pixels in every mode", function()
		for _, modeName in { "px", "scale", "percent", "hybrid" } do
			local scale, offset = Geometry.cornerConvert(0, 12, 200, 80, modeName :: any, nil, 1)
			t.near(Geometry.cornerPixels(scale, offset, 200, 80, 1), 12, 1)
			local backScale, backOffset = Geometry.cornerConvert(scale, offset, 200, 80, "px", nil, 1)
			t.eq(backScale, 0)
			t.near(backOffset, 12, 1)
		end
	end)
	t.case("cornerConvert scale mode is relative to the smaller side", function()
		local scale, offset = Geometry.cornerConvert(0, 10, 200, 40, "scale")
		t.near(scale, 0.25)
		t.eq(offset, 0)
	end)
	t.case("cornerConvert clamps to half of the smaller side", function()
		local scale = Geometry.cornerConvert(0, 500, 200, 40, "scale")
		t.near(scale, 0.5)
	end)
	t.case("cornerConvert percent uses explicit values", function()
		local scale, offset = Geometry.cornerConvert(0, 5, 100, 100, "percent", 25)
		t.near(scale, 0.25)
		t.eq(offset, 0)
	end)
	t.case("cornerConvert hybrid splits scale and offset", function()
		local scale, offset = Geometry.cornerConvert(0, 20, 200, 100, "hybrid", 0.5)
		t.near(scale, 0.1)
		t.eq(offset, 10)
	end)
	t.case("paddingConvert round-trips between scale and offset", function()
		local scale, offset = Geometry.paddingConvert(0, 24, 300, 1, true)
		t.near(scale, 0.08)
		t.eq(offset, 0)
		local backScale, backOffset = Geometry.paddingConvert(scale, offset, 300, 1, false)
		t.eq(backScale, 0)
		t.eq(backOffset, 24)
	end)
	t.case("paddingConvert with zero reference keeps the value", function()
		local scale, offset = Geometry.paddingConvert(0.1, 8, 0, 1, true)
		t.eq(scale, 0.1)
		t.eq(offset, 8)
	end)
	t.case("clampTextRange orders and bounds", function()
		local low, high = Geometry.clampTextRange(30, 10)
		t.eq(low, 30)
		t.eq(high, 30)
		low, high = Geometry.clampTextRange(0, 500)
		t.eq(low, 1)
		t.eq(high, 100)
	end)
	t.case("sizeLimits multiplies by the factors", function()
		local minX, minY, maxX, maxY = Geometry.sizeLimits(200, 100, 0.5, 2)
		t.eq(minX, 100)
		t.eq(minY, 50)
		t.eq(maxX, 400)
		t.eq(maxY, 200)
	end)
	t.case("alignAxis picks the edge, center or far edge of the reference", function()
		t.eq(Geometry.alignAxis("min", 50, 30, 10, 110), 10)
		t.eq(Geometry.alignAxis("center", 50, 30, 10, 110), 45)
		t.eq(Geometry.alignAxis("max", 50, 30, 10, 110), 80)
	end)
	t.case("distributeAxis equalizes gaps between first and last in position order", function()
		local out = Geometry.distributeAxis({ { pos = 100, size = 20 }, { pos = 0, size = 20 }, { pos = 30, size = 40 } })
		t.eq(out[1], 100)
		t.eq(out[2], 0)
		t.eq(out[3], 40)
	end)
	t.case("distributeAxis leaves fewer than three untouched", function()
		local out = Geometry.distributeAxis({ { pos = 5, size = 20 }, { pos = 70, size = 20 } })
		t.eq(out[1], 5)
		t.eq(out[2], 70)
	end)
	t.case("spacingAxis keeps the first fixed and uses the given gap", function()
		local out = Geometry.spacingAxis({ { pos = 10, size = 20 }, { pos = 50, size = 20 }, { pos = 200, size = 20 } }, 5)
		t.eq(out[1], 10)
		t.eq(out[2], 35)
		t.eq(out[3], 60)
	end)
	t.case("spacingAxis without a gap uses the average", function()
		local out = Geometry.spacingAxis({ { pos = 0, size = 10 }, { pos = 20, size = 10 }, { pos = 100, size = 10 } })
		t.eq(out[2], 50)
		t.eq(out[3], 100)
	end)
	t.case("gridGuess orders row-major and finds cell, gaps and aspect", function()
		local guess = Geometry.gridGuess({
			{ x = 120, y = 0, w = 100, h = 50 },
			{ x = 0, y = 60, w = 100, h = 50 },
			{ x = 0, y = 0, w = 100, h = 50 },
			{ x = 120, y = 60, w = 100, h = 50 },
		})
		t.eq(guess.order[1], 3)
		t.eq(guess.order[2], 1)
		t.eq(guess.order[3], 2)
		t.eq(guess.order[4], 4)
		t.eq(guess.cellW, 100)
		t.eq(guess.cellH, 50)
		t.eq(guess.gapX, 20)
		t.eq(guess.gapY, 10)
		t.eq(guess.aspect, 2)
	end)
	t.case("gridGuess drops the aspect when sizes differ more than 5 percent", function()
		local guess = Geometry.gridGuess({ { x = 0, y = 0, w = 100, h = 50 }, { x = 110, y = 0, w = 100, h = 80 } })
		t.eq(guess.aspect, nil)
	end)
end
