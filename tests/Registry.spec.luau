local Registry = require("../src/App/Registry")

local function ctx()
	return { store = nil, plugin = nil, notify = function() end, t = function(k) return k end }
end

return function(t)
	t.case("runs a defined command with its arguments", function()
		local r = Registry.new()
		r:define("demo.add", "cmd_demo", function(_, a, b)
			return { ok = true, count = a + b }
		end)
		local result = r:run("demo.add", ctx(), 2, 3)
		t.eq(result.ok, true)
		t.eq(result.count, 5)
	end)
	t.case("result args pass through run", function()
		local r = Registry.new()
		r:define("demo.args", "cmd_demo", function()
			return { ok = false, count = 0, message = "m", args = { 3 } }
		end)
		local result = r:run("demo.args", ctx())
		t.eq(result.message, "m")
		t.eq(result.args[1], 3)
	end)
	t.case("unknown id returns error_unknown_command", function()
		local result = Registry.new():run("nope", ctx())
		t.eq(result.ok, false)
		t.eq(result.message, "error_unknown_command")
	end)
	t.case("a command that throws returns error_command_failed", function()
		local r = Registry.new()
		r:define("demo.boom", "cmd_demo", function()
			error("boom")
		end)
		local result = r:run("demo.boom", ctx())
		t.eq(result.ok, false)
		t.eq(result.message, "error_command_failed")
	end)
	t.case("list keeps definition order", function()
		local r = Registry.new()
		r:define("a.one", "k1", function() return { ok = true, count = 0 } end)
		r:define("b.two", "k2", function() return { ok = true, count = 0 } end)
		local list = r:list()
		t.eq(#list, 2)
		t.eq(list[1].id, "a.one")
		t.eq(list[2].labelKey, "k2")
	end)
	t.case("a command returning a non-result is a failure", function()
		local r = Registry.new()
		r:define("demo.nil", "cmd_demo", function() return nil :: any end)
		local result = r:run("demo.nil", ctx())
		t.eq(result.ok, false)
		t.eq(result.message, "error_command_failed")
	end)
	t.case("run holds while the command executes and calls onHold first", function()
		local r = Registry.new()
		local log = {}
		r.onHold = function()
			table.insert(log, "hold")
		end
		r:define("demo.peek", "cmd_demo", function()
			table.insert(log, if r:held() then "held" else "free")
			r:run("demo.inner", ctx())
			table.insert(log, if r:held() then "held" else "free")
			return { ok = true, count = 0 }
		end)
		r:define("demo.inner", "cmd_demo", function()
			return { ok = true, count = 0 }
		end)
		t.eq(r:held(), false)
		r:run("demo.peek", ctx())
		t.eq(table.concat(log, ","), "hold,held,hold,held")
		t.eq(r:held(), false)
	end)
	t.case("hold is released when the command throws or onHold fails", function()
		local r = Registry.new()
		r.onHold = function()
			error("hook")
		end
		r:define("demo.boom", "cmd_demo", function()
			error("boom")
		end)
		t.eq(r:run("demo.boom", ctx()).message, "error_command_failed")
		t.eq(r:held(), false)
	end)
	t.case("a yielding command keeps the hold until it returns", function()
		local task = require("@lune/task")
		local r = Registry.new()
		local resumed = false
		local finished = false
		r:define("demo.wait", "cmd_demo", function()
			task.wait(0.02)
			resumed = r:held()
			return { ok = true, count = 0 }
		end)
		task.spawn(function()
			r:run("demo.wait", ctx())
			finished = true
		end)
		t.eq(r:held(), true)
		task.wait(0.01)
		t.eq(r:held(), true)
		t.eq(finished, false)
		task.wait(0.1)
		t.eq(finished, true)
		t.eq(resumed, true)
		t.eq(r:held(), false)
	end)
end
