local luau = require("@lune/luau")
local roblox = require("@lune/roblox")
local RuntimeSource = require("../src/Import/RuntimeSource")
local Installer = require("../src/Runtime/Installer")

local function service()
	return {}
end

local Runtime = luau.load(RuntimeSource, {
	debugName = "Runtime",
	environment = {
		game = { GetService = service },
		workspace = {},
		Enum = roblox.Enum,
		Vector2 = roblox.Vector2,
		Color3 = roblox.Color3,
		TweenInfo = {
			new = function(time, style, direction)
				return { Time = time, EasingStyle = style, EasingDirection = direction }
			end,
		},
	},
})()

local M = Runtime.math

return function(t)
	t.case("runtime names the user's motion curves", function()
		t.eq(Runtime.CURVES.SETTLE.style, roblox.Enum.EasingStyle.Quad)
		t.eq(Runtime.CURVES.SETTLE.direction, roblox.Enum.EasingDirection.Out)
		t.eq(Runtime.CURVES.CALM.style, roblox.Enum.EasingStyle.Sine)
		t.eq(Runtime.CURVES.CALM.direction, roblox.Enum.EasingDirection.InOut)
		t.eq(Runtime.CURVES.ARRIVE.style, roblox.Enum.EasingStyle.Back)
		t.eq(Runtime.CURVES.ARRIVE.direction, roblox.Enum.EasingDirection.Out)
		t.eq(Runtime.CURVES.LEAVE.style, roblox.Enum.EasingStyle.Quad)
		t.eq(Runtime.CURVES.LEAVE.direction, roblox.Enum.EasingDirection.In)
	end)
	t.case("runtime names the user's durations", function()
		t.eq(Runtime.DURATIONS.BUTTON, 0.12)
		t.eq(Runtime.DURATIONS.CHIP, 0.2)
		t.eq(Runtime.DURATIONS.CARD, 0.22)
		t.eq(Runtime.DURATIONS.WINDOW, 0.26)
		t.eq(Runtime.DURATIONS.TROPHY, 0.34)
		local info = Runtime.tween(Runtime.DURATIONS.CARD, Runtime.CURVES.SETTLE)
		t.near(info.Time, 0.22)
		t.eq(info.EasingStyle, roblox.Enum.EasingStyle.Quad)
	end)
	t.case("easing curves hit their endpoints and shapes", function()
		for name, curve in Runtime.CURVES do
			t.near(curve.ease(0), 0)
			t.near(curve.ease(1), 1)
			assert(curve.ease(0.5) > 0, name)
		end
		t.near(Runtime.CURVES.CALM.ease(0.5), 0.5)
		t.near(Runtime.CURVES.CALM.ease(0.25), (1 - math.cos(math.pi / 4)) / 2)
		t.near(Runtime.CURVES.SETTLE.ease(0.5), 0.75)
		t.near(Runtime.CURVES.LEAVE.ease(0.5), 0.25)
		assert(Runtime.CURVES.ARRIVE.ease(0.6) > 1, "Back Out overshoots")
	end)
	t.case("clampRange never inverts bounds", function()
		t.eq(M.clampRange(5, 0, 3), 3)
		t.eq(M.clampRange(-1, 0, 3), 0)
		t.eq(M.clampRange(5, 4, 2), 4)
	end)
	t.case("viewportRatio by mode", function()
		local ref = roblox.Vector2.new(1920, 1080)
		t.near(M.viewportRatio("min", roblox.Vector2.new(1280, 720), ref), 2 / 3)
		t.near(M.viewportRatio("min", roblox.Vector2.new(2560, 1080), ref), 1)
		t.near(M.viewportRatio("width", roblox.Vector2.new(2560, 1080), ref), 4 / 3)
		t.near(M.viewportRatio("height", roblox.Vector2.new(960, 540), ref), 0.5)
	end)
	t.case("wrap wave starts at the base and wraps inside the range", function()
		t.near(M.wrapWave(0, 0.5, 1), 0)
		t.near(M.wrapWave(0.5, 0.5, 1), 0.5)
		t.near(M.wrapWave(0.9, 0.5, 1), 0.9)
		t.near(M.wrapWave(1.1, 0.5, 1), -0.9)
		t.eq(M.wrapWave(3, 0.5, 0), 0)
	end)
	t.case("ping-pong wave turns at the range", function()
		t.near(M.pingPongWave(0, 1, 0.5), 0)
		t.near(M.pingPongWave(0.25, 1, 0.5), 0.5)
		t.near(M.pingPongWave(0.5, 1, 0.5), 0)
		t.near(M.pingPongWave(0.75, 1, 0.5), -0.5)
		t.near(M.pingPongWave(1, 1, 0.5), 0)
		assert(M.pingPongWave(0.3, 1, 0.5) < M.pingPongWave(0.25, 1, 0.5), "turns back after the peak")
	end)
	t.case("pulse wave is a sine of the speed", function()
		t.near(M.pulseWave(0, 2, 0.3), 0)
		t.near(M.pulseWave(0.125, 2, 0.3), 0.3)
	end)
	t.case("shine progress sweeps once per interval", function()
		t.near(M.shineProgress(0, 2.4, 0.6), 0)
		t.near(M.shineProgress(0.3, 2.4, 0.6), 0.5)
		t.eq(M.shineProgress(0.7, 2.4, 0.6), nil)
		t.near(M.shineProgress(2.4 + 0.15, 2.4, 0.6), 0.25)
		t.near(M.shineProgress(0.9, 0.5, 1), 0.9)
		t.eq(M.shineProgress(1, 1, 0), nil)
	end)
	t.case("shine offset crosses the object with the CALM curve", function()
		t.near(M.shineOffset(0), -1)
		t.near(M.shineOffset(0.5), 0)
		t.near(M.shineOffset(1), 1)
		t.near(M.shineOffset(0.25), -1 + 2 * Runtime.CURVES.CALM.ease(0.25))
	end)
	t.case("finite rejects NaN, infinities and non-numbers", function()
		t.eq(M.finite(1), true)
		t.eq(M.finite(0 / 0), false)
		t.eq(M.finite(math.huge), false)
		t.eq(M.finite("1"), false)
	end)
	t.case("motion axis follows the gradient rotation", function()
		t.near(M.axisOf(0).X, 1)
		t.near(M.axisOf(0).Y, 0)
		t.near(M.axisOf(90).X, 0)
		t.near(M.axisOf(90).Y, 1)
		t.near(M.shineReach(0), 1)
		t.near(M.shineReach(45), math.sqrt(2))
		t.near(M.shineReach(-20), math.cos(math.rad(20)) + math.sin(math.rad(20)))
	end)
	t.case("loader is exactly two lines", function()
		local lines = string.split(Installer.LOADER, "\n")
		t.eq(#lines, 2)
		t.eq(lines[1], 'local Runtime = require(game:GetService("ReplicatedStorage"):WaitForChild("Quadro"):WaitForChild("Runtime"))')
		t.eq(lines[2], "Runtime.start()")
	end)
end
