local serde = require("@lune/serde")
local Settings = require("../src/Studio/Settings")

Settings.codec = {
	encode = function(value)
		return serde.encode("json", value)
	end,
	decode = function(text)
		return serde.decode("json", text)
	end,
}

local function memoryPlugin()
	local stored = {}
	return {
		stored = stored,
		SetSetting = function(_, key, value)
			stored[key] = value
		end,
		GetSetting = function(_, key)
			return stored[key]
		end,
	}
end

return function(t)
	t.case("save wraps the value as JSON under the Quadro_ prefix", function()
		local plugin = memoryPlugin()
		t.eq(Settings.save(plugin :: any, "tab", "figma"), true)
		t.eq(typeof(plugin.stored.Quadro_tab), "string")
		t.eq(Settings.load(plugin :: any).tab, "figma")
	end)
	t.case("booleans and tables round-trip", function()
		local plugin = memoryPlugin()
		Settings.save(plugin :: any, "notifications", false)
		Settings.save(plugin :: any, "quickActions", { "layout.fit" })
		local loaded = Settings.load(plugin :: any)
		t.eq(loaded.notifications, false)
		t.eq(loaded.quickActions[1], "layout.fit")
	end)
	t.case("save reports failure when SetSetting throws", function()
		local fake = {
			SetSetting = function()
				error("denied")
			end,
			GetSetting = function()
				return nil
			end,
		}
		t.eq(Settings.save(fake :: any, "tab", "figma"), false)
	end)
	t.case("open sections are independent sets that round-trip", function()
		local plugin = memoryPlugin()
		Settings.save(plugin :: any, "openSections", { tools = { quick = true, anchor = true }, effects = {} })
		local loaded = Settings.load(plugin :: any)
		t.eq(loaded.openSections.tools.quick, true)
		t.eq(loaded.openSections.tools.anchor, true)
		t.eq(next(loaded.openSections.effects), nil)
		t.eq(loaded.openSections.layout.align, true)
		t.eq(loaded.openSections.builders.path, true)
	end)
	t.case("open sections drop unknown ids and non-true values", function()
		local plugin = memoryPlugin()
		Settings.save(plugin :: any, "openSections", { tools = { nowhere = true, quick = "yes", anchor = false }, ghost = { a = true } })
		local loaded = Settings.load(plugin :: any)
		t.eq(next(loaded.openSections.tools), nil)
		t.eq(loaded.openSections.ghost, nil)
	end)
	t.case("old string shape migrates to a set", function()
		local plugin = memoryPlugin()
		Settings.save(plugin :: any, "openSections", { tools = "", effects = "motion", layout = "nowhere" })
		local loaded = Settings.load(plugin :: any)
		t.eq(next(loaded.openSections.tools), nil)
		t.eq(loaded.openSections.effects.motion, true)
		t.eq(loaded.openSections.layout.align, true)
		t.eq(Settings.load(memoryPlugin() :: any).openSections.effects.studio, true)
	end)
	t.case("load keeps the defaults when nothing is saved", function()
		local loaded = Settings.load(memoryPlugin() :: any)
		t.eq(loaded.lang, "pt")
		t.eq(loaded.tab, "tools")
		t.eq(loaded.pixelSnap, true)
	end)
	t.case("invalid uiScale and lang fall back to defaults", function()
		local plugin = memoryPlugin()
		Settings.save(plugin :: any, "uiScale", 3)
		Settings.save(plugin :: any, "lang", "xx")
		local loaded = Settings.load(plugin :: any)
		t.eq(loaded.uiScale, 1)
		t.eq(loaded.lang, "pt")
	end)
	t.case("valid uiScale and lang load", function()
		local plugin = memoryPlugin()
		Settings.save(plugin :: any, "uiScale", 1.25)
		Settings.save(plugin :: any, "lang", "en")
		local loaded = Settings.load(plugin :: any)
		t.eq(loaded.uiScale, 1.25)
		t.eq(loaded.lang, "en")
	end)
	t.case("load ignores a value of the wrong type", function()
		local plugin = memoryPlugin()
		plugin.stored.Quadro_tab = Settings.codec.encode({ v = 42 })
		t.eq(Settings.load(plugin :: any).tab, "tools")
	end)
	t.case("load migrates the saved gradients tab to effects", function()
		local plugin = memoryPlugin()
		Settings.save(plugin :: any, "tab", "gradients")
		t.eq(Settings.load(plugin :: any).tab, "effects")
	end)
	t.case("every tab id round-trips", function()
		for _, id in Settings.TAB_IDS do
			local plugin = memoryPlugin()
			Settings.save(plugin :: any, "tab", id)
			t.eq(Settings.load(plugin :: any).tab, id)
		end
	end)
	t.case("load ignores an unknown tab", function()
		local plugin = memoryPlugin()
		Settings.save(plugin :: any, "tab", "nowhere")
		t.eq(Settings.load(plugin :: any).tab, "tools")
	end)
	t.case("load never aliases the defaults tables", function()
		local first = Settings.load(memoryPlugin() :: any)
		table.insert(first.quickActions, "x")
		local second = Settings.load(memoryPlugin() :: any)
		t.eq(#second.quickActions, 4)
	end)
	t.case("load clamps hybrid shares and text sizes", function()
		local plugin = memoryPlugin()
		Settings.save(plugin :: any, "hybridX", 4)
		Settings.save(plugin :: any, "hybridY", -2)
		Settings.save(plugin :: any, "textMin", 0)
		Settings.save(plugin :: any, "textMax", 900)
		local loaded = Settings.load(plugin :: any)
		t.eq(loaded.hybridX, 1)
		t.eq(loaded.hybridY, 0)
		t.eq(loaded.textMin, 1)
		t.eq(loaded.textMax, 100)
	end)
	t.case("load orders text min and max and replaces NaN", function()
		local plugin = memoryPlugin()
		Settings.save(plugin :: any, "textMin", 60)
		Settings.save(plugin :: any, "textMax", 20)
		Settings.save(plugin :: any, "hybridX", 0 / 0)
		local loaded = Settings.load(plugin :: any)
		t.eq(loaded.textMin, 60)
		t.eq(loaded.textMax, 60)
		t.eq(loaded.hybridX, 0.7)
	end)
end
