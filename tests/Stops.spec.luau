local Codec = require("../src/Gradients/Codec")
local Stops = require("../src/Gradients/Stops")

local function sample()
	return {
		name = "x",
		rotation = 0,
		offset = { 0, 0 },
		color = { { t = 0, c = "ffffff", a = 0 }, { t = 0.2, c = "ff0000", a = 0 }, { t = 1, c = "000000", a = 0 } },
		transparency = { { 0, 0 }, { 1, 1 } },
	}
end

local function times(list, kind)
	local out = {}
	for _, point in list do
		table.insert(out, string.format("%.2f", if kind == "color" then point.t else point[1]))
	end
	return table.concat(out, ",")
end

local function pairsText(points)
	local out = {}
	for _, point in points do
		table.insert(out, string.format("%.3f:%.3f", point[1], point[2]))
	end
	return table.concat(out, ",")
end

return function(t)
	t.case("snap rounds to 0.01 and clamps", function()
		t.eq(Stops.snap(0.4249), 0.42)
		t.eq(Stops.snap(0.4251), 0.43)
		t.eq(Stops.snap(-0.3), 0)
		t.eq(Stops.snap(1.7), 1)
	end)
	t.case("colorAt interpolates in RGB", function()
		local data = sample()
		t.eq(Stops.colorAt(data.color, 0.1), "ff8080")
		t.eq(Stops.colorAt(data.color, 0.6), "800000")
		t.eq(Stops.colorAt(data.color, 0), "ffffff")
		t.eq(Stops.colorAt(data.color, 1), "000000")
	end)
	t.case("valueAt interpolates transparency", function()
		t.near(Stops.valueAt({ { 0, 0 }, { 0.5, 1 }, { 1, 0 } }, 0.25), 0.5)
		t.near(Stops.valueAt({ { 0, 0.2 }, { 1, 0.6 } }, 0.5), 0.4)
	end)
	t.case("add inserts at the midpoint of the widest gap with the interpolated color", function()
		local data, index = Stops.add(sample(), "color")
		assert(data and index)
		t.eq(index, 3)
		t.eq(times(data.color, "color"), "0.00,0.20,0.60,1.00")
		t.eq(data.color[3].c, "800000")
	end)
	t.case("add on transparency uses the interpolated value", function()
		local data, index = Stops.add(sample(), "transparency")
		assert(data and index)
		t.eq(index, 2)
		t.eq(pairsText(data.transparency), "0.000:0.000,0.500:0.500,1.000:1.000")
	end)
	t.case("add refuses past the keypoint limit", function()
		local data = sample()
		data.color = {}
		for i = 0, Codec.MAX_KEYPOINTS - 1 do
			table.insert(data.color, { t = i / (Codec.MAX_KEYPOINTS - 1), c = "ffffff", a = 0 })
		end
		t.eq(Stops.add(data, "color"), nil)
	end)
	t.case("remove drops an inner stop and keeps endpoints", function()
		local data = Stops.remove(sample(), "color", 2)
		assert(data)
		t.eq(times(data.color, "color"), "0.00,1.00")
		t.eq(Stops.remove(sample(), "color", 1), nil)
		t.eq(Stops.remove(sample(), "color", 3), nil)
		t.eq(Stops.remove(sample(), "transparency", 1), nil)
	end)
	t.case("move snaps, clamps and re-sorts", function()
		local base = Stops.add(sample(), "color")
		assert(base)
		local moved, index = Stops.move(base, "color", 2, 0.7349)
		t.eq(times(moved.color, "color"), "0.00,0.60,0.73,1.00")
		t.eq(index, 3)
		t.eq(moved.color[3].c, "ff0000")
		local low, lowIndex = Stops.move(base, "color", 3, -2)
		t.eq(times(low.color, "color"), "0.00,0.01,0.20,1.00")
		t.eq(lowIndex, 2)
		t.eq(low.color[2].c, "800000")
		local high = Stops.move(base, "color", 2, 5)
		t.eq(times(high.color, "color"), "0.00,0.60,0.99,1.00")
	end)
	t.case("move never lands on another stop", function()
		local data = sample()
		data.color = { { t = 0, c = "ffffff", a = 0 }, { t = 0.3, c = "ff0000", a = 0 }, { t = 0.5, c = "00ff00", a = 0 }, { t = 1, c = "000000", a = 0 } }
		local up, upIndex = Stops.move(data, "color", 2, 0.5)
		t.eq(times(up.color, "color"), "0.00,0.49,0.50,1.00")
		t.eq(upIndex, 2)
		local down, downIndex = Stops.move(data, "color", 3, 0.3004)
		t.eq(times(down.color, "color"), "0.00,0.30,0.31,1.00")
		t.eq(downIndex, 3)
		t.eq(down.color[3].c, "00ff00")
		local past, pastIndex = Stops.move(data, "color", 2, 0.6)
		t.eq(times(past.color, "color"), "0.00,0.50,0.60,1.00")
		t.eq(pastIndex, 3)
		data.color = { { t = 0, c = "ffffff", a = 0 }, { t = 0.01, c = "ff0000", a = 0 }, { t = 0.4, c = "00ff00", a = 0 }, { t = 1, c = "000000", a = 0 } }
		local floor = Stops.move(data, "color", 3, -1)
		t.eq(times(floor.color, "color"), "0.00,0.01,0.02,1.00")
	end)
	t.case("move leaves endpoints in place", function()
		local data = sample()
		local moved, index = Stops.move(data, "color", 1, 0.5)
		t.eq(moved, data)
		t.eq(index, 1)
	end)
	t.case("set replaces a color or clamps a value", function()
		local data = Stops.set(sample(), "color", 2, "00ff00")
		t.eq(data.color[2].c, "00ff00")
		t.eq(sample().color[2].c, "ff0000")
		local faded = Stops.set(sample(), "transparency", 2, 3)
		t.eq(faded.transparency[2][2], 1)
	end)
	t.case("hex helpers", function()
		t.eq(Stops.parseHex(" #A1b2C3 "), "a1b2c3")
		t.eq(Stops.parseHex("12345"), nil)
		t.eq(Stops.hex(255.4, -3, 300), "ff00ff")
		local r, g, b = Stops.rgb("0a80ff")
		t.eq(r, 10)
		t.eq(g, 128)
		t.eq(b, 255)
	end)
	t.case("mask keypoints per side", function()
		local rotation, points = Stops.mask("bottom", 0.3)
		t.eq(rotation, 90)
		t.eq(pairsText(points), "0.000:0.000,0.700:0.000,1.000:1.000")
		rotation, points = Stops.mask("top", 0.25)
		t.eq(rotation, 90)
		t.eq(pairsText(points), "0.000:1.000,0.250:0.000,1.000:0.000")
		rotation, points = Stops.mask("left", 0.1)
		t.eq(rotation, 0)
		t.eq(pairsText(points), "0.000:1.000,0.100:0.000,1.000:0.000")
		rotation, points = Stops.mask("right", 0.2)
		t.eq(rotation, 0)
		t.eq(pairsText(points), "0.000:0.000,0.800:0.000,1.000:1.000")
	end)
	t.case("mask edges follow the axis and clamp the length", function()
		local rotation, points = Stops.mask("edges", 0.2, "h")
		t.eq(rotation, 0)
		t.eq(pairsText(points), "0.000:1.000,0.200:0.000,0.800:0.000,1.000:1.000")
		rotation, points = Stops.mask("edges", 0.2, "v")
		t.eq(rotation, 90)
		rotation, points = Stops.mask("edges", 0.9, "h")
		t.eq(pairsText(points), "0.000:1.000,0.500:0.000,1.000:1.000")
		rotation, points = Stops.mask("right", 0.01)
		t.eq(pairsText(points), "0.000:0.000,0.950:0.000,1.000:1.000")
	end)
	t.case("edited data round-trips through Codec", function()
		local data = Stops.add(sample(), "color")
		assert(data)
		data = Stops.move(data, "color", 3, 0.45)
		data = Stops.set(data, "transparency", 2, 0.5)
		local _, mask = Stops.mask("edges", 0.15, "h")
		data.transparency = mask
		local clean = Codec.sanitize(data)
		assert(clean)
		t.eq(Codec.signature(clean), Codec.signature(data))
		t.eq(times(clean.color, "color"), "0.00,0.20,0.45,1.00")
		t.eq(Codec.sanitize(Stops.DEFAULT) ~= nil, true)
	end)
end
