local Strings = require("../src/UI/Strings")

return function(t)
	t.case("returns the Portuguese text", function()
		t.eq(Strings.get("pt", "tab_tools"), "Ferramentas")
	end)
	t.case("returns the English text", function()
		t.eq(Strings.get("en", "tab_tools"), "Tools")
	end)
	t.case("unknown language falls back to English", function()
		t.eq(Strings.get("xx", "tab_tools"), "Tools")
	end)
	t.case("unknown key returns the key", function()
		t.eq(Strings.get("pt", "no_such_key"), "no_such_key")
	end)
	t.case("formats arguments", function()
		t.eq(Strings.get("pt", "selection_many", 3), "3 selecionados")
	end)
	t.case("Portuguese covers every English key", function()
		t.eq(#Strings.missing("pt"), 0)
	end)
end
