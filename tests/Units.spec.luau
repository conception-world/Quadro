local Units = require("../src/Import/Units")

return function(t)
	t.case("size divides by the inner box", function()
		local sx, sy = Units.size(415, 123, 840, 991)
		t.near(sx, 0.494)
		t.near(sy, 0.1241)
	end)
	t.case("position is the anchored point inside the padding", function()
		local px, py = Units.position(30, 20, 100, 50, { 10, 10, 10, 10 }, 400, 200, 0.5, 0.5)
		t.near(px, (20 + 50) / 400)
		t.near(py, (10 + 25) / 200)
	end)
	t.case("nested nodes always anchor at the center", function()
		local ax, ay, reason = Units.anchor({ h = "MIN", v = "MIN" }, false)
		t.eq(ax, 0.5)
		t.eq(ay, 0.5)
		t.eq(reason, nil)
	end)
	t.case("root children pinned to an edge keep that edge with a reason", function()
		local ax, ay, reason = Units.anchor({ h = "MIN", v = "MAX" }, true)
		t.eq(ax, 0)
		t.eq(ay, 1)
		t.eq(type(reason), "string")
	end)
	t.case("root children centered have no reason", function()
		local ax, ay, reason = Units.anchor({ h = "CENTER", v = "SCALE" }, true)
		t.eq(ax, 0.5)
		t.eq(ay, 0.5)
		t.eq(reason, nil)
	end)
	t.case("corner and stroke scale by the shortest side", function()
		local c = Units.corner({ 4, 4, 4, 4 }, 415, 123)
		t.near(c[1], 0.0325)
		t.near(Units.stroke(1.5, 415, 123), 0.0122)
	end)
	t.case("padding scales per side", function()
		local p = Units.padding({ 14, 16, 14, 16 }, 415, 123)
		t.near(p[1], 14 / 123)
		t.near(p[2], 16 / 415)
	end)
	t.case("gap uses the layout axis", function()
		t.near(Units.gap(10, "H", 400, 100), 0.025)
		t.near(Units.gap(10, "V", 400, 100), 0.1)
	end)
	t.case("full screen is any 16:9 box within 0.01", function()
		t.eq(Units.fullScreen(1920, 1080), true)
		t.eq(Units.fullScreen(1280, 720), true)
		t.eq(Units.fullScreen(1366, 768), true)
		t.eq(Units.fullScreen(1280, 728), false)
		t.eq(Units.fullScreen(600, 400), false)
		t.eq(Units.fullScreen(800, 0), false)
	end)
	t.case("text max size is 1.5x rounded down", function()
		t.eq(Units.textMax(24), 36)
		t.eq(Units.textMax(13), 19)
	end)
	t.case("shadow converts to scale and transparency", function()
		local s = Units.shadow({ kind = "dropShadow", hex = "000000", a = 0.28, x = 0, y = 5, blur = 10, spread = 0 }, 415, 123)
		t.near(s.y, 5 / 123)
		t.near(s.blur, 10 / 123)
		t.near(s.transparency, 0.72)
	end)
	t.case("hex converts to unit rgb", function()
		local r, g, b = Units.hexToRgb("ff8000")
		t.near(r, 1)
		t.near(g, 128 / 255)
		t.near(b, 0)
	end)
end
